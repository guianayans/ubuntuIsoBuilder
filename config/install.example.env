# Exemplo de config/install.env — gerado automaticamente por ./setup.sh.
# Você pode copiar para config/install.env e editar à mão, mas o formato é
# estrito: apenas linhas KEY='valor' (aspas simples). Este arquivo NÃO contém
# segredos: senha (hash) e auth key do Tailscale ficam em secrets/.

# Série LTS: 24.04 ou 26.04 (a última point release é baixada e verificada)
UBUNTU_SERIES='24.04'

# Sistema (HOSTNAME_ com sublinhado, pois HOSTNAME é variável reservada do bash)
HOSTNAME_='meu-servidor'
ADMIN_USER='admin'
ADMIN_REALNAME='Administrador'
TIMEZONE='America/Sao_Paulo'
LOCALE='pt_BR.UTF-8'
KEYBOARD_LAYOUT='br'
KEYBOARD_VARIANT=''

# Rede: dhcp | static
NET_MODE='dhcp'
# Para static: NET_MATCH_TYPE = mac | name | glob
NET_MATCH_TYPE='glob'
NET_MATCH_VALUE='en*'
# ex.: 192.168.1.50/24
NET_ADDRESS=''
# ex.: 192.168.1.1
NET_GATEWAY=''
# ex.: 1.1.1.1,8.8.8.8
NET_DNS=''
# ex.: lan
NET_SEARCH=''

# Disco: STORAGE_MATCH_TYPE = serial | path | model | single
STORAGE_MATCH_TYPE='serial'
STORAGE_MATCH_VALUE='S4EWNX0N123456'
STORAGE_MIN_GB='100'
# lvm | direct
STORAGE_LAYOUT='lvm'
# yes somente se o disco de destino for USB/externo (recusado por padrão)
STORAGE_ALLOW_USB='no'
# Preenchido pelo setup quando você digita APAGAR: 'APAGAR:<tipo>:<valor>'
STORAGE_CONFIRMED=''

# SSH: key (só chave, recomendado) | password (usuário e senha; senha aceita só
# da rede local e do Tailscale, fail2ban ativo; chaves continuam opcionais)
SSH_AUTH='key'
# Porta do SSH no servidor instalado (22 = padrão; ou 1024-65535, ex.: 2222)
SSH_PORT='22'

# Tailscale (a auth key fica em secrets/tailscale-authkey)
TAILSCALE_ENABLED='yes'
TAILSCALE_HOSTNAME='meu-servidor'
# ex.: --advertise-tags=tag:server
TAILSCALE_EXTRA_ARGS=''

# Docker Engine + Compose plugin
DOCKER_ENABLED='yes'
# Coolify (exige Docker). A senha do admin fica em secrets/coolify-password
COOLIFY_ENABLED='no'
COOLIFY_ADMIN_EMAIL=''
# Cockpit completo (-backports), só junto com o Coolify pelo assistente
COCKPIT_ENABLED='no'

# ---- Extras (os mesmos recursos do host-mirror; todos opcionais)
# DDNS No-IP (a senha fica em secrets/ddns-password)
DDNS_ENABLED='no'
DDNS_HOSTNAME=''
DDNS_LOGIN=''
# Cloudflare Tunnel gerenciado pelo painel da Cloudflare (token em secrets/cloudflare-token)
CLOUDFLARE_ENABLED='no'
# GPU NVIDIA: driver recomendado + GPU nos containers (se houver Docker/Coolify)
GPU_NVIDIA='no'
# Virtualização KVM/libvirt; VIRT_BRIDGE=yes cria a ponte br0 (VMs na rede local)
VIRT_ENABLED='no'
VIRT_BRIDGE='no'
# Ajustes de base: fsck automático no boot, console sem apagar, IOMMU (com virtualização)
SERVER_TWEAKS='no'
# Agente do Remoto (MeshCentral): o servidor aparece em <painel>/remoto/.
# O id do grupo fica em secrets/remote-meshid (o painel preenche sozinho).
REMOTE_AGENT='no'
REMOTE_AGENT_URL=''

# Pacotes extras além de: curl wget git ca-certificates openssh-server htop unzip rsync
EXTRA_PACKAGES=''
